# =============================================================================
# ML Pipeline Monitor - .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# --- Virtual Environments ---
.venv/
venv/
env/
.env
.env.local
.env.*.local

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Testing / Coverage ---
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# --- Streamlit ---
.streamlit/secrets.toml

# --- Secrets ---
.secrets.json

# --- Runtime Database ---
.pipeline_monitor.db
.pipeline_monitor.db-shm
.pipeline_monitor.db-wal
*.db
*.db-shm
*.db-wal

# --- Artifacts / Model Files ---
artifacts/models/*.joblib
artifacts/models/*.pkl
artifacts/scalers/*.joblib
artifacts/scalers/*.pkl
artifacts/feature_store/*.joblib
artifacts/feature_store/*.pkl
.model_artifacts/
*.joblib
*.pkl

# --- Logs ---
logs/
*.log

# --- Playwright / E2E ---
playwright-report/
test-results/
blob-report/
.playwright/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Docker ---
docker-compose.override.yml

# --- Build ---
*.tar.gz
*.zip

# --- Backups ---
backups/

# --- Deepeval ---
.deepeval/
