[run]
source = src/ml_pipeline_monitor
omit =
    */tests/*
    */test_*
    src/ml_pipeline_monitor/core/auth.py
    src/ml_pipeline_monitor/utils/ui_theme.py
    src/ml_pipeline_monitor/services/worker.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
fail_under = 80