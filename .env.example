# =============================================================================
# ML Pipeline Monitor - Environment Variables Template
# =============================================================================
# Copy to .env and fill in every value marked REQUIRED:
#     cp .env.example .env
#
# Generate a secret:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Comments live on their own lines. Do NOT append them after a value: an
# inline comment is stripped from the value, so `KEY=  # explain` sets KEY to
# the empty string rather than to anything useful.
# =============================================================================

# --- Database (REQUIRED) -----------------------------------------------------
POSTGRES_USER=mlmonitor
POSTGRES_DB=mlmonitor

# REQUIRED: token_urlsafe(32)
POSTGRES_PASSWORD=

# REQUIRED: must match the three values above.
# Format: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
PIPELINE_DB_DSN=

# --- Auth (REQUIRED) ---------------------------------------------------------
# REQUIRED: token_urlsafe(48)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# REQUIRED: token_urlsafe(32). Authenticates the deprecated /predict endpoint.
# Leave blank to disable that endpoint entirely (it then rejects every request).
MLMONITOR_API_KEY=

MLMONITOR_AUTH_ENABLED=true
AUTH_USERNAME=admin

# REQUIRED: token_urlsafe(24), or a bcrypt hash ($2b$...), which is preferred.
# Generate a hash: python -c "import bcrypt;print(bcrypt.hashpw(b'PASSWORD', bcrypt.gensalt(12)).decode())"
AUTH_PASSWORD=
AUTH_ROLE=admin

# Optional: multiple users as JSON, overrides AUTH_USERNAME/AUTH_PASSWORD.
# Example: {"alice":{"password":"$2b$12$...","role":"admin"}}
AUTH_USERS_JSON=

# --- TLS / Let's Encrypt (required only for the nginx `production` profile) ---
# Public DNS name for this deployment. Must already resolve to this host, and
# port 80 must be reachable from the internet for the ACME challenge.
DOMAIN=
# Address Let's Encrypt uses for expiry warnings.
CERTBOT_EMAIL=
# Set true to rehearse against the Let's Encrypt STAGING environment first.
# Production issuance is rate limited to 5 failures per hostname per hour, so
# a misconfigured first attempt can lock you out for an hour.
CERTBOT_STAGING=false

# --- Monitoring (REQUIRED) ---------------------------------------------------
GRAFANA_USER=admin

# REQUIRED: token_urlsafe(24)
GRAFANA_PASSWORD=

# REQUIRED only when running the "monitoring" profile (Flower dashboard).
# Format: user:password
FLOWER_BASIC_AUTH=

# --- Rate limiting (optional) ------------------------------------------------
MLMONITOR_RATE_LIMIT=100/minute
# Tighter bucket applied to /v1/auth/login and /v1/auth/refresh.
MLMONITOR_AUTH_RATE_LIMIT=10/minute

# --- API (optional) ----------------------------------------------------------
# Comma-separated CORS origins. Empty disables CORS entirely (recommended
# unless a browser front-end on another origin needs to call the API).
MLMONITOR_CORS_ORIGINS=

# Number of production models held in memory by the inference cache.
MLMONITOR_MODEL_CACHE_SIZE=8

# --- SMTP (optional, for alerts) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Slack (optional) --------------------------------------------------------
SLACK_WEBHOOK=

# --- MLflow (optional) -------------------------------------------------------
MLFLOW_TRACKING_URI=

# --- Redis (optional) --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
