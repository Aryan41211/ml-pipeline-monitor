# ML Pipeline Monitor - Environment Variables Template
# Copy this file to .env and fill in the values.
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Database (REQUIRED) ---
POSTGRES_USER=mlmonitor
POSTGRES_PASSWORD=          # REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=mlmonitor
PIPELINE_DB_DSN=            # REQUIRED: postgresql://<user>:<password>@postgres:5432/<db>

# --- Auth (REQUIRED) ---
JWT_SECRET=                 # REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
MLMONITOR_API_KEY=          # REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MLMONITOR_AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=              # REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
AUTH_ROLE=admin

# --- Monitoring (REQUIRED) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=           # REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- Rate Limiting (optional) ---
MLMONITOR_RATE_LIMIT=100/minute

# --- SMTP (optional, for alerts) ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Slack (optional) ---
SLACK_WEBHOOK=

# --- MLflow (optional) ---
MLFLOW_TRACKING_URI=

# --- Redis (optional, for caching) ---
REDIS_URL=redis://redis:6379/0
